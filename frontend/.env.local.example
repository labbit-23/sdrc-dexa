# Copy to .env.local

# Self-hosted Supabase
NEXT_PUBLIC_SUPABASE_URL=http://192.168.1.50:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (for the regenerate API route)
SUPABASE_URL=http://192.168.1.50:8000
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Optional: worker HTTP API URL (for immediate regeneration)
# WORKER_HTTP_URL=http://192.168.1.10:8765
